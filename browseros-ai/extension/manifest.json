{
  "manifest_version": 3,
  "name": "BrowserOS AI Companion",
  "version": "0.1.0",
  "description": "AI companion extension for BrowserOS AI dashboard and automation controls.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrowserOS AI"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
